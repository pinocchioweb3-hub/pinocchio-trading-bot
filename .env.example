# =============================================================================
# 環境變數範本 — 複製成 .env 並填入實際值（.env 永不進 git）
# =============================================================================

# --- CoinGlass API（Step 9 之後需要；訂閱 Startup $79/月）---
COINGLASS_API_KEY=

# --- CryptoPanic 新聞 API（免費 1000/天）---
# 註冊：https://cryptopanic.com/developers/api/keys
CRYPTOPANIC_TOKEN=

# --- OKX 唯讀 API（Step 10 之後需要）---
# 重要：建立 key 時：
#   1. 只勾「讀取」權限，禁勾「交易」「提現」
#   2. 綁定 VPS IP 白名單
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- OKX 交易 API（階段 2 才需要，用獨立 key）---
# 重要：禁勾「提現」；限額；綁 IP 白名單
OKX_TRADE_API_KEY=
OKX_TRADE_API_SECRET=
OKX_TRADE_API_PASSPHRASE=

# --- Telegram Bot（Step 11 之後需要）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TimescaleDB（Step 10 起跑 Docker 時自動填）---
DB_DSN=postgresql://trader:CHANGE_ME@localhost:5432/trading

# --- Anthropic（L3 Claude headless 用）---
ANTHROPIC_API_KEY=

# --- 風控參數（botconfig.py 統一讀取，v23-2 起全部真實生效）---
#
# v42 依預算自適應：本金是可設定參數，風控護欄依本金自動分級。
#   分級「只填你沒設定的鍵」；任何你明確設定的值一律優先（你最大）。
#   分級（未設定時的保守預設）：
#     micro  本金 <1,000U   → 槓桿 3x／風險 1.0%／日開倉 2／總曝險 5%／無獨立現貨
#     small  1,000–4,999U   → 槓桿 5x／風險 1.0%／日開倉 3／總曝險 6%
#     standard 5,000–9,999U → 同上 ＋ 解鎖獨立現貨策略
#     large  ≥10,000U       → 同 standard
#   ⚠️ 分級是「工具的安全預設」，不是投資建議；本金越小保護越嚴，且永不比大本金更激進。
#
# 帳戶本金（USDT）— 決定上面落在哪一級
ACCOUNT_BALANCE_USD=5000
#
# 單筆風險 = 1R。兩種設法（擇一；都不設→落 tier 的 1.0%）：
#   (A) 固定美元：RISK_PER_TRADE_USD=100
#   (B) 帳戶百分比：RISK_PER_TRADE_PCT=2  （>0 時優先，1R = 本金 × %）
RISK_PER_TRADE_USD=100
# RISK_PER_TRADE_PCT=
# 最多同時持倉數（舊鍵名 MAX_CONCURRENT_POSITIONS 仍相容）
MAX_CONCURRENT_TRADES=3
# 預設槓桿（不設→落 tier 的保守上限：micro 3x／其餘 5x）
DEFAULT_LEVERAGE=15
# 總曝險上限（佔本金 %）/ 每日最多開倉次數 —— 不設→落 tier 預設（6%／3）
# TOTAL_RISK_CAP_PCT=6.0
# DAILY_MAX_OPENS=3
TIMEZONE=Asia/Taipei

# --- 交易計畫參數（可選覆寫；省略用預設）---
# SL_PCT_INTRADAY=4.0
# SL_PCT_AMBUSH=5.0
# TP_R_INTRADAY=1.0,1.5,2.0
# TP_R_AMBUSH=1.0,1.5,2.5
# TP_SIZE_SPLIT=0.5,0.3,0.2
